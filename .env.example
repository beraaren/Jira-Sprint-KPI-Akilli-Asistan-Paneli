# Jira baglanti ayarlari sablonu.
#
# KULLANIM: bu dosyayi ".env" adiyla kopyalayin ve degerleri doldurun.
#   copy .env.example .env
#
# ".env" .gitignore'dadir - iceri versiyon kontrolune GIRMEZ.

# Kurumunuzun Jira adresi (sonunda / olmadan).
JIRA_BASE_URL=https://jira.turkcell.com.tr

# Jira > sag ust profil resmi > Profile > Personal Access Tokens > Create token
JIRA_PAT=

# Proje ANAHTARI (orn. MS) veya sayisal proje ID'si (orn. 31031) - ikisi de kabul edilir.
JIRA_PROJECT_KEY=

# Kac ay geriye gidilsin (created tarihine gore).
JIRA_MONTHS_BACK=6

# Kurumsal SSL kesmesi nedeniyle sertifika hatasi aliyorsaniz true yapin.
# Ilk deneme her zaman sertifika DOGRULAMALI yapilir; bu sadece hata halinde
# sertifikasiz bir kez daha denenmesine izin verir.
JIRA_SKIP_SSL=false

# Alan eslestirmesi. Bunlar DOLDURULURSA panel "Baglan ve Kesfet" adimini
# tamamen atlar ve dogrudan veri ceker. Bos birakirsaniz panel her acilista
# kesif yapip size sorar (ve dogru degerleri bu formatta ekrana yazar - oradan
# kopyalayip buraya yapistirabilirsiniz).
JIRA_FIELD_STORY_POINTS=
JIRA_FIELD_DEVELOPER=
JIRA_FIELD_ANALYST=

# Sprint ve Last Transition alanlari panelde SORULMAZ; adlari standart oldugu
# icin otomatik bulunur. Sadece otomatik bulma calismazsa doldurun
# (orn. customfield_10004). Last Transition, haftalik ozetin dayandigi alandir.
JIRA_FIELD_SPRINT=
JIRA_FIELD_LAST_TRANSITION=

# true ise panel acilir acilmaz veriyi otomatik ceker (butona basmaya gerek
# kalmaz). Yukaridaki alan eslestirmesi dolu degilse yok sayilir.
JIRA_AUTO_CONNECT=false
